# =============================================================================
# Esplendido Automation - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Gmail API
# -----------------------------------------------------------------------------
# Path to your OAuth 2.0 credentials JSON file (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be cached (created automatically after first auth)
GOOGLE_TOKEN_PATH=.token.pickle

# -----------------------------------------------------------------------------
# Anthropic API
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx