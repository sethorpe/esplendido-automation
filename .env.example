# Esplendido Automation Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Gmail IMAP Configuration
# =============================================================================
# Gmail address that receives utility invoices
GMAIL_ADDRESS=your-email@gmail.com

# Google App Password (16 characters, no spaces)
# Create at: https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on the Google account
GMAIL_APP_PASSWORD=abcdefghijklmnop

# =============================================================================
# Anthropic API (for PDF extraction)
# =============================================================================
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# PDF Extraction mode override (optional)
# =============================================================================
# Set to 'claude' to use Claude API instead of local parsing
# EXTRACTION_MODE=local

# =============================================================================
# RentBook Credentials
# =============================================================================
# Create a dedicated user with username/password login (not Google OAuth)
RENTBOOK_EMAIL=your-rentbook-user@example.com
RENTBOOK_PASSWORD=your-rentbook-password

# =============================================================================
# Optional: Override config.yaml sender addresses
# =============================================================================
# CITY_SENDER_EMAIL=no-reply@example.co.za
# CITY_SEARCH_SUBJECT="sample email subject"
# BODY_CORPORATE_SENDER_EMAIL=noreply@example.co.za
# BODY_CORP_SEARCH_SUBJECT="Monthly Statement for Unit 123456"
